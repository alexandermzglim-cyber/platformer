{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Python Game",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pygame_port/main.py",
      "cwd": "${workspaceFolder}/pygame_port",
      "python": "C:/Users/JohnGay/AppData/Local/Programs/Python/Python313/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug C Game",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/platformer.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
      "preLaunchTask": "Build",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
