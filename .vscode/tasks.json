{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "mingw32-make",
      "options": {
        "shell": {
          "executable": "C:\\msys64\\usr\\bin\\bash.exe",
          "args": ["--login", "-i", "-c"]
        },
        "env": {
          "MSYSTEM": "MINGW64",
          "CHERE_INVOKING": "1"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "mingw32-make clean",
      "options": {
        "shell": {
          "executable": "C:\\msys64\\usr\\bin\\bash.exe",
          "args": ["--login", "-i", "-c"]
        },
        "env": {
          "MSYSTEM": "MINGW64",
          "CHERE_INVOKING": "1"
        }
      }
    }
  ]
}
